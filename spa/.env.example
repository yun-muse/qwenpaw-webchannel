# Build-time config for the hosted relay. Copy to .env.local and rebuild.
#
# Leave BOTH unset for local development: the SPA then targets
# ws://127.0.0.1:8787/ws/client and shows no login gate.

# Full URL of the relay's client WebSocket leg.
VITE_RELAY_WS=wss://qwenpaw-webchannel-relay.<account>.workers.dev/ws/client

# HTTP base of the same relay — used for POST /api/login.
# A non-empty value turns on the login gate.
VITE_RELAY_HTTP=https://qwenpaw-webchannel-relay.<account>.workers.dev
